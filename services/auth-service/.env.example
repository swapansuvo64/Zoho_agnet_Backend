ZOHO_CLIENT_ID=your_zoho_client_id_here
ZOHO_CLIENT_SECRET=your_zoho_client_secret_here
ZOHO_REDIRECT_URI=http://your_auth_service_host:your_auth_service_port/auth/callback

# Zoho API endpoints
# Note: Use your Zoho DC domain (.com, .in, .eu, etc.) for Zoho URLs
ZOHO_AUTH_URL=https://accounts.zoho.in/oauth/v2/auth
ZOHO_TOKEN_URL=https://accounts.zoho.in/oauth/v2/token
ZOHO_USER_INFO_URL=https://accounts.zoho.in/oauth/user/info
ZOHO_PORTALS_URL=https://projectsapi.zoho.in/restapi/portals/

# Supabase config
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key_here

# Redis config
REDIS_URL=redis://your_redis_host:your_redis_port/0

# Cryptography
ENCRYPTION_KEY=your_fernet_encryption_key_here

# JWT auth config
JWT_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ALGORITHM=your_jwt_algorithm_here_e.g_HS256
JWT_ACCESS_EXPIRE=your_access_token_expiry_in_seconds
JWT_REFRESH_EXPIRE=your_refresh_token_expiry_in_seconds

# Application config
FRONTEND_URL=http://your_frontend_host:your_frontend_port
ENVIRONMENT=development
